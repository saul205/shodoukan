# Prod environment (deploy/deploy.sh). Copy to deploy/.env.prod on the host
# and fill in with real, unique passwords. Never commit the copy.

# The Tailscale Funnel URL: https://shodoukan.<your-tailnet>.ts.net
PUBLIC_URL=https://shodoukan.example.ts.net
PUBLIC_SCHEME=https

# Practice database. Use letters and digits in the password: it goes into a URL.
PRACTICE_DB_USER=shodoukan
PRACTICE_DB_PASSWORD=
PRACTICE_DB_NAME=shodoukan_practice

# Keycloak's own database and its first admin (admin console on
# http://localhost:${KEYCLOAK_ADMIN_PORT}/idp/admin, this machine only).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_PORT=8180

# Tailscale auth key (admin console > Settings > Keys), only used for the
# first login; the node's state is kept in a volume afterwards.
TS_AUTHKEY=
