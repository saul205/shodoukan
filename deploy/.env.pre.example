# Pre (deploy/deploy.sh). Copy to deploy/.env.pre and fill in. Pre has its
# own databases and never touches the dev ones. Passwords are only applied
# when a database is first created: change them later with ALTER USER (see
# docs/technical/deployment.md).

# Where browsers reach pre. Sign-in only works on this URL.
#  - With the tunnel: https://shodoukan.<your-tailnet>.ts.net, scheme https,
#    COMPOSE_PROFILES=tunnel and TS_AUTHKEY set.
#  - Without it (this machine only): http://localhost:8088, scheme http.
PUBLIC_URL=http://localhost:8088
PUBLIC_SCHEME=http
COMPOSE_PROFILES=
WEB_PORT=8088

# Tailscale auth key (admin console > Settings > Keys), only used for the
# node's first login; its state is kept in a volume afterwards.
TS_AUTHKEY=

# Practice database. Use letters and digits in the password: it goes into a URL.
PRACTICE_DB_USER=shodoukan
PRACTICE_DB_PASSWORD=change-me
PRACTICE_DB_NAME=shodoukan_practice

# Keycloak's own database and its admin (console on
# http://localhost:${KEYCLOAK_ADMIN_PORT}/idp/admin, this machine only).
# Keep this admin: keycloak-setup signs in with it on every start.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_PORT=8181

# deploy/deploy.sh seed: dev realm usernames to copy into pre, with their
# practice data (space or comma separated; empty copies every user).
SEED_USERS=
