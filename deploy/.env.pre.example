# Pre environment (deploy/pre.sh). Copy to deploy/.env.pre and fill in.
# Pre has its own databases; it never touches the dev ones.

# Where the browser reaches the stack, and its scheme (Keycloak needs it).
PUBLIC_URL=http://localhost:8088
PUBLIC_SCHEME=http
WEB_PORT=8088

# Practice database. Use letters and digits in the password: it goes into a URL.
PRACTICE_DB_USER=shodoukan
PRACTICE_DB_PASSWORD=change-me
PRACTICE_DB_NAME=shodoukan_practice

# Keycloak's own database and its first admin (admin console on
# http://localhost:${KEYCLOAK_ADMIN_PORT}/idp/admin, this machine only).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_PORT=8181
