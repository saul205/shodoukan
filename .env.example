# Port to expose the API on
# API_PORT=8000

# Set to 1 to include score breakdown in search responses
SHODOUKAN_DEBUG=0

# Comma-separated list of allowed frontend origins
# Development: * (allow all)
# Production:  https://your-app.onrender.com
CORS_ORIGINS=*

# ── Practice database (shodoukan-practice) ────────────────────────────────────
# Read by the practice-db container (docker compose up -d practice-db).
POSTGRES_USER=shodoukan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shodoukan_practice

# SQLAlchemy URL used by shodoukan-practice and its Alembic migrations.
# Must match the values above. Host is localhost from your machine and
# practice-db from another compose service.
PRACTICE_DATABASE_URL=postgresql+psycopg://shodoukan:change-me@localhost:5432/shodoukan_practice
