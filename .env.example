# Absolute path to shodoukan.sqlite on the host (optional).
# Defaults to ~/.local/share/shodoukan/shodoukan.sqlite — the same location
# used by `shodoukan-setup`. Only set this if the database is elsewhere.
# DB_PATH=/custom/path/to/shodoukan.sqlite

# Port to expose the API on (default: 8000)
# API_PORT=8000
