# Port to expose the API on
# API_PORT=8000

# Set to 1 to include score breakdown in search responses
SHODOUKAN_DEBUG=0

# Comma-separated list of allowed frontend origins
# Development: * (allow all)
# Production:  https://your-app.onrender.com
CORS_ORIGINS=*

# ── Practice database (shodoukan-practice) ────────────────────────────────────
# Read by the practice-db container (docker compose up -d practice-db).
POSTGRES_USER=shodoukan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shodoukan_practice

# SQLAlchemy URL used by shodoukan-practice and its Alembic migrations.
# Must match the values above. Host is localhost from your machine and
# practice-db from another compose service.
PRACTICE_DATABASE_URL=postgresql+psycopg://shodoukan:change-me@localhost:5432/shodoukan_practice

# Optional: path to the shodoukan dictionary SQLite, read by the library (used by
# shodoukan-api and shodoukan-practice). Default: ~/.local/share/shodoukan/shodoukan.sqlite
# SHODOUKAN_DB_PATH=/data/shodoukan.sqlite

# ── Practice API authentication (Keycloak) ────────────────────────────────────
# Realm URL; access tokens must carry it as `iss`. Required to serve requests.
AUTH_ISSUER=https://keycloak.example.com/realms/shodoukan
# Optional: required `aud` claim (needs an audience mapper in Keycloak).
# AUTH_AUDIENCE=shodoukan-practice
# Optional: defaults to <AUTH_ISSUER>/protocol/openid-connect/certs
# AUTH_JWKS_URL=
