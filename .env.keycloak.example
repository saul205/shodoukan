# Keycloak and its own database (docker compose services keycloak-db, keycloak).
# Copy to .env.keycloak (gitignored) and set real passwords.

# keycloak-db: Postgres creates this database and user on first start; Keycloak
# then creates its own tables in it.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me

# keycloak: connects to the database above (values reused, not repeated)
KC_DB_URL_DATABASE=${POSTGRES_DB}
KC_DB_USERNAME=${POSTGRES_USER}
KC_DB_PASSWORD=${POSTGRES_PASSWORD}

# First admin of the console at http://localhost:8080/admin
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
